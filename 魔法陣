local function createLayerImage(parent, name, imageId, scale, color, zIndex)
	local img = Instance.new("ImageLabel")
	img.Name = name
	img.Image = imageId
	img.ImageColor3 = color
	img.Size = UDim2.fromScale(scale, scale)
	img.Position = UDim2.fromScale(0.5, 0.5)
	img.AnchorPoint = Vector2.new(0.5, 0.5)
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.ImageTransparency = 0
	img.ScaleType = Enum.ScaleType.Fit
	img.ZIndex = zIndex
	img.Parent = parent
	return img
end

local function createLayeredMagicGui(face)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "RayfieldMagicSurface_" .. face.Name
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 128
	sg.LightInfluence = 0
	sg.AlwaysOnTop = false
	sg.Adornee = basePart
	sg.Parent = basePart

	local container = Instance.new("Frame")
	container.Name = "Container"
	container.Size = UDim2.fromScale(1, 1)
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.BackgroundTransparency = 1
	container.Parent = sg

	local outerImg = createLayerImage(container, "OuterLayer", ASSET_OUTER, state.outer.scaleBase, PURPLE_OUTER, 1)
	local middleImg = createLayerImage(container, "MiddleLayer", ASSET_MIDDLE, state.middle.scaleBase, PURPLE_OUTER, 2)
	local centerImg = createLayerImage(container, "CenterLayer", ASSET_CENTER, state.center.scaleBase, PURPLE_OUTER, 3)

	return {
		outerImg = outerImg,
		middleImg = middleImg,
		centerImg = centerImg
	}
end

