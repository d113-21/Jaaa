local renderConn
renderConn = RunService.RenderStepped:Connect(function(dt)
	if not state.active then
		basePart.CFrame = CFrame.new(0, -500, 0)
		particleAnchor.CFrame = CFrame.new(0, -500, 0)
		return
	end

	enforceThirdPersonCamera()

	local footCf = getFootPositionCFrame()
	if footCf then
		basePart.CFrame = footCf
		particleAnchor.CFrame = footCf + Vector3.new(0, 0.65, 0)
		animateMagic(dt)
	else
		basePart.CFrame = CFrame.new(0, -500, 0)
		particleAnchor.CFrame = CFrame.new(0, -500, 0)
	end
end)

local function cleanup()
	state.active = false
	restoreCameraSettings()
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	if circleFolder then
		circleFolder:Destroy()
	end
	pcall(function()
		Rayfield:Destroy()
	end)
end

env.MagicCircleCleanup = cleanup

