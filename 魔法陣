local function enforceThirdPersonCamera()
	local currentCam = workspace.CurrentCamera
	if not currentCam then
		return
	end
	local maxMult = math.max(state.center.scaleMax, state.middle.scaleMax, state.outer.scaleMax)
	local desiredDistance = math.clamp(state.baseSize * maxMult * 1.1 + 10, 14, 140)
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = math.max(9, desiredDistance * 0.6)
	player.CameraMaxZoomDistance = math.max(desiredDistance + 20, 65)
	currentCam.CameraType = Enum.CameraType.Custom

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if rootPart then
		local camOffset = currentCam.CFrame.Position - rootPart.Position
		if camOffset.Magnitude < 6 then
			local backDir = -rootPart.CFrame.LookVector
			local targetPos = rootPart.Position + backDir * desiredDistance + Vector3.new(0, desiredDistance * 0.45, 0)
			currentCam.CFrame = CFrame.lookAt(targetPos, rootPart.Position + Vector3.new(0, 1.5, 0))
		end
	end
end

local function restoreCameraSettings()
	player.CameraMinZoomDistance = state.savedMinZoom
	player.CameraMaxZoomDistance = state.savedMaxZoom
end

local function getFootPositionCFrame()
	local character = player.Character
	if not character then
		return nil
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart then
		return nil
	end
	local hipOffset = 3
	if humanoid and humanoid.HipHeight > 0 then
		hipOffset = humanoid.HipHeight + 1.85
	end
	local footPos = rootPart.Position - Vector3.new(0, hipOffset, 0)
	return CFrame.new(footPos)
end

local function updateSingleLayer(layerState, imgTop, imgBot, dt)
	local shouldLoopSpin = state.globalLoop and layerState.loopSpin
	if shouldLoopSpin then
		layerState.angle = (layerState.angle + layerState.spinSpeed * dt) % 360
	else
		layerState.angle = layerState.angle + layerState.spinSpeed * dt
	end

	local mult = 1
	if state.scaleAnimEnabled then
		local shouldLoopScale = state.globalLoop and layerState.loopScale
		if shouldLoopScale then
			layerState.phase = (layerState.phase + dt * layerState.scaleSpeed) % (math.pi * 2)
		else
			layerState.phase = layerState.phase + dt * layerState.scaleSpeed
		end
		local wave = (math.sin(layerState.phase - math.pi * 0.5) + 1) * 0.5
		mult = layerState.scaleMin + (layerState.scaleMax - layerState.scaleMin) * wave
	end

	local finalScale = layerState.scaleBase * mult
	imgTop.Rotation = layerState.angle
	imgTop.Size = UDim2.fromScale(finalScale, finalScale)
	imgTop.ImageColor3 = PURPLE_OUTER

	imgBot.Rotation = layerState.angle
	imgBot.Size = UDim2.fromScale(finalScale, finalScale)
	imgBot.ImageColor3 = PURPLE_OUTER
end

local function animateMagic(dt)
	basePart.Size = Vector3.new(state.baseSize, 0.12, state.baseSize)
	updateParticleWidth()

	updateSingleLayer(state.center, topGui.centerImg, bottomGui.centerImg, dt)
	updateSingleLayer(state.middle, topGui.middleImg, bottomGui.middleImg, dt)
	updateSingleLayer(state.outer, topGui.outerImg, bottomGui.outerImg, dt)
end

