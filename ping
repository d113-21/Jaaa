local resizing = false
local startMouse, startSize

resizeHandle.MouseButton1Down:Connect(function()
    resizing = true
    startMouse = UserInputService:GetMouseLocation()
    startSize = logGui.AbsoluteSize
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = false
    end
end)

RunService.RenderStepped:Connect(function()
    if resizing then
        local currentMouse = UserInputService:GetMouseLocation()
        local delta = currentMouse - startMouse
        local newWidth = math.clamp(startSize.X + delta.X, 280, 600)
        local newHeight = math.clamp(startSize.Y + delta.Y, 180, 450)
        logGui.Size = UDim2.new(0, newWidth, 0, newHeight)
    end
end)

local function showLog()
    logGui.Size = UDim2.new(0, 50, 0, 50)
    logGui.Position = UDim2.new(0.5, -25, 0.5, -25)
    logGui.Visible = true

    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local goal = {
        Size = UDim2.new(0, 380, 0, 260),
        Position = UDim2.new(0.5, -190, 0.5, -130)
    }
    TweenService:Create(logGui, tweenInfo, goal):Play()
end

plusBtn.MouseButton1Click:Connect(function()
    if logGui.Visible then
        logGui.Visible = false
    else
        showLog()
    end
end)

-- 更新処理 + 幅自動調整
local acc = 0
RunService.Heartbeat:Connect(function(dt)
    acc = acc + dt
    if acc < 0.5 then return end
    acc = 0

    local currentTime = os.date("%H:%M:%S")
    local fps = math.floor(Stats.Workspace.Heartbeat:GetValue())
    local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())

    label.Text = string.format("Clyrix | %s | %d FPS | %d ms", currentTime, fps, ping)

    local textWidth = label.TextBounds.X
    local newWidth = textWidth + 20
    frame.Size = UDim2.new(0, newWidth, 0, 26)
    frame.Position = UDim2.new(0.5, -newWidth / 2, 0, 12)
end)
