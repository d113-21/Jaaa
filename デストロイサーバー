local ESPGui = Instance.new("ScreenGui")
ESPGui.Name = "CornerESP_UI"
ESPGui.ResetOnSpawn = false
ESPGui.IgnoreGuiInset = true
ESPGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
local ESPContainer = Instance.new("Frame")
ESPContainer.Size = UDim2.new(1, 0, 1, 0)
ESPContainer.BackgroundTransparency = 1
ESPContainer.Parent = ESPGui
local PlayerUI = {}

local function createBar(parent)
    local b = Instance.new("Frame")
    b.BackgroundColor3 = Color3.fromRGB(0, 255, 0); b.BorderSizePixel = 0
    b.AnchorPoint = Vector2.new(0.5, 0.5); b.Visible = false; b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = b
    return b
end

local function createUIForPlayer(player)
    local h = Instance.new("Frame")
    h.Name = "ESP_" .. player.Name; h.BackgroundTransparency = 1
    h.Size = UDim2.new(1, 0, 1, 0); h.Parent = ESPContainer
    local bars = {}
    for i = 1, 8 do bars[i] = createBar(h) end
    local nl = Instance.new("TextLabel")
    nl.BackgroundTransparency = 1
    nl.TextColor3 = ESPConfig.NameColor; nl.TextStrokeTransparency = 0
    nl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); nl.Font = Enum.Font.SourceSansBold
    nl.TextSize = ESPConfig.NameSize; nl.AnchorPoint = Vector2.new(0.5, 0.5)
    nl.Rotation = 0; nl.Text = player.Name; nl.Visible = false; nl.Parent = h
    return {holder = h, bars = bars, nameLabel = nl}
end

local function hideAll(d)
    if not d then return end
    for _, b in ipairs(d.bars) do b.Visible = false end
    if d.nameLabel then d.nameLabel.Visible = false end
end

local function getThick(side)
    if not ESPConfig.AdaptiveThickness then return ESPConfig.Thickness end
    local f = math.clamp(side / 100, 0.4, 1.0)
    return math.max(2, ESPConfig.Thickness * f)
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not ESPConfig.Enabled then
            for _, d in pairs(PlayerUI) do hideAll(d) end
            return
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local head = char and char:FindFirstChild("Head")
                local hum = char and char:FindFirstChild("Humanoid")
                if hrp and head and hum and hum.Health > 0 then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local dist = (myRoot.Position - hrp.Position).Magnitude
                        if dist <= ESPConfig.MaxDistance then
                            if not PlayerUI[player] then PlayerUI[player] = createUIForPlayer(player) end
                            local d = PlayerUI[player]
                            local tw = head.Position + Vector3.new(0, ESPConfig.TopOffset, 0)
                            local bw = hrp.Position - Vector3.new(0, ESPConfig.BottomOffset, 0)
                            local top, tOn = Camera:WorldToViewportPoint(tw)
                            local bot, bOn = Camera:WorldToViewportPoint(bw)
                            if tOn and bOn then
                                local side = math.abs(bot.Y - top.Y) * ESPConfig.BoxSizeMult
                                local cx, cy = (top.X + bot.X) / 2, (top.Y + bot.Y) / 2
                                local bx, by = cx - side / 2, cy - side / 2
                                local arm = side * ESPConfig.CornerLength
                                local th = getThick(side)
                                local color = ESPConfig.UseRainbow and Color3.fromHSV(ESPConfig.RainbowHue, 1, 1) or ESPConfig.NameColor
                                local rot = ESPConfig.RotationAngle
                                local cr, sr = math.cos(rot), math.sin(rot)
                                local function rp(px, py)
                                    local dx, dy = px - cx, py - cy
                                    return cx + (dx * cr - dy * sr), cy + (dx * sr + dy * cr)
                                end
                                local function setBar(bar, x, y, sx, sy)
                                    bar.Size = UDim2.new(0, sx, 0, sy)
                                    bar.Position = UDim2.new(0, x, 0, y)
                                    bar.Rotation = math.deg(rot)
                                    bar.BackgroundColor3 = color
                                    bar.Visible = true
                                    local uc = bar:FindFirstChildOfClass("UICorner")
                                    if uc then uc.CornerRadius = UDim.new(0, math.min(th / 2, ESPConfig.Roundness)) end
                                end
                                local x1,y1 = rp(bx + arm/2, by); setBar(d.bars[1], x1, y1, arm, th)
                                local x2,y2 = rp(bx, by + arm/2); setBar(d.bars[2], x2, y2, th, arm)
                                local x3,y3 = rp(bx + side - arm/2, by); setBar(d.bars[3], x3, y3, arm, th)
                                local x4,y4 = rp(bx + side, by + arm/2); setBar(d.bars[4], x4, y4, th, arm)
                                local x5,y5 = rp(bx + arm/2, by + side); setBar(d.bars[5], x5, y5, arm, th)
                                local x6,y6 = rp(bx, by + side - arm/2); setBar(d.bars[6], x6, y6, th, arm)
                                local x7,y7 = rp(bx + side - arm/2, by + side); setBar(d.bars[7], x7, y7, arm, th)
                                local x8,y8 = rp(bx + side, by + side - arm/2); setBar(d.bars[8], x8, y8, th, arm)
                                if ESPConfig.ShowName then
                                    local nw = head.Position + Vector3.new(0, ESPConfig.TopOffset + ESPConfig.NameWorldOffsetY, 0)
                                    local ns, nOn = Camera:WorldToViewportPoint(nw)
                                    if nOn then
                                        d.nameLabel.Position = UDim2.new(0, ns.X, 0, ns.Y)
                                        d.nameLabel.Text = player.Name
                                        d.nameLabel.TextColor3 = ESPConfig.NameColor
                                        d.nameLabel.Rotation = 0
                                        d.nameLabel.Visible = true
                                    else d.nameLabel.Visible = false end
                                else d.nameLabel.Visible = false end
                            else hideAll(d) end
                        else hideAll(PlayerUI[player]) end
                    end
                else hideAll(PlayerUI[player]) end
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(p)
    if PlayerUI[p] then PlayerUI[p].holder:Destroy(); PlayerUI[p] = nil end
end)

task.spawn(function()
    local dir = 1
    while true do
        task.wait(0.03)
        if ESPConfig.Enabled then
            ESPConfig.BoxSizeMult = ESPConfig.BoxSizeMult + (ESPConfig.AutoSizeSpeed * dir * 0.03)
            if ESPConfig.BoxSizeMult >= ESPConfig.AutoSizeMax then ESPConfig.BoxSizeMult = ESPConfig.AutoSizeMax; dir = -1
            elseif ESPConfig.BoxSizeMult <= ESPConfig.AutoSizeMin then ESPConfig.BoxSizeMult = ESPConfig.AutoSizeMin; dir = 1 end
            ESPConfig.RotationAngle = ESPConfig.RotationAngle + (ESPConfig.RotationSpeed * 0.03)
            if ESPConfig.RotationAngle > math.pi * 2 then ESPConfig.RotationAngle = ESPConfig.RotationAngle - math.pi * 2 end
            ESPConfig.RainbowHue = (ESPConfig.RainbowHue + ESPConfig.RainbowSpeed * 0.03) % 1
        end
    end
end)

