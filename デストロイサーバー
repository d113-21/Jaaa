GroundTab:CreateToggle({Name = "プロット破壊を実行", CurrentValue = false, Flag = "PlotBreakToggle",
    Callback = function(v)
        _G.PlotBreakEnabled = v
        if v then task.spawn(function()
            local ps = {}
            while _G.PlotBreakEnabled do
                local valid = {}
                for _, name in pairs(selectedPlots) do
                    local plot = workspace.Plots:FindFirstChild(name)
                    local area = plot and plot:FindFirstChild("PlotArea")
                    if area then table.insert(valid, area) end
                end
                local container = getTargetContainer(LocalPlayer)
                if container and #valid > 0 then
                    local alive = {}
                    for _, sh in pairs(ps) do if sh and sh.Parent then table.insert(alive, sh) end end
                    ps = alive
                    if #ps < #valid then
                        local ns = spawnAndAttachShuriken(valid[#ps + 1], container)
                        if ns then table.insert(ps, ns) end
                    end
                end
                task.wait(0.5)
            end
            for _, sh in pairs(ps) do destroyShuriken(sh) end
        end) end
    end})
GroundTab:CreateSection("地面・パーツ破壊")
GroundTab:CreateToggle({Name = "選んだやつをけす", CurrentValue = false, Flag = "AutoGroundBreak",
    Callback = function(v)
        _G.GroundBreakEnabled = v
        if v then task.spawn(function()
            local gs = {}
            while _G.GroundBreakEnabled do
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local rp = RaycastParams.new()
                    rp.FilterDescendantsInstances = {LocalPlayer.Character}
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    local res = workspace:Raycast(hrp.Position, Vector3.new(0, -10, 0), rp)
                    local t = res and res.Instance
                    if t and t:IsA("BasePart") and not t:IsA("Terrain") then
                        local container = getTargetContainer(LocalPlayer)
                        if container then
                            local ns = spawnAndAttachShuriken(t, container)
                            if ns then table.insert(gs, ns) end
                        end
                    end
                end
                task.wait(0.8)
            end
            for _, sh in pairs(gs) do destroyShuriken(sh) end
        end) end
    end})

