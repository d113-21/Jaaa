DestroyTab:CreateButton({Name = "Destroy Server", Callback = function()
    task.spawn(function()
        pcall(function()
            local h = (selectedHeight == "Heaven") and 1e9 or 35
            lineLagEnabled = true
            task.spawn(function()
                while lineLagEnabled do
                    pcall(function()
                        local cl = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")
                        if cl then
                            local sl = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawn")
                                or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
                            if sl then
                                for i = 1, lineCount do
                                    cl:FireServer(sl, CFrame.new(math.random(-1e9,1e9), 0, math.random(-1e9,1e9)))
                                end
                            end
                        end
                    end)
                    task.wait(0.01)
                end
            end)
            task.wait(1)
            local ps = {}
            for _, plr in pairs(Players:GetPlayers()) do if plr ~= LocalPlayer then table.insert(ps, plr) end end
            if #ps == 0 then lineLagEnabled = false; notify("Destroy", "対象なし", 3); return end
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHrp then lineLagEnabled = false; return end
            local pd = {}
            for _, plr in ipairs(ps) do
                local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then table.insert(pd, {player = plr, hrp = hrp}) end
            end
            for _, d in ipairs(pd) do
                pcall(function() myHrp.CFrame = d.hrp.CFrame * CFrame.new(0, 5, 5); myHrp.AssemblyLinearVelocity = Vector3.zero end)
                task.wait(0.2)
                if GrabEvents then
                    local so = GrabEvents:FindFirstChild("SetNetworkOwner")
                    if so then
                        for i = 1, 2 do
                            pcall(function() so:FireServer(d.hrp, d.hrp.CFrame) end)
                            pcall(function() so:FireServer(d.hrp) end)
                            task.wait(0.05)
                        end
                    end
                end
                task.wait()
            end
            local radius = 50
            local step = (math.pi * 2) / #pd
            for i, d in ipairs(pd) do
                local a = (i - 1) * step
                local x, z = math.cos(a) * radius, math.sin(a) * radius
                pcall(function()
                    d.hrp.CFrame = CFrame.new(x, h, z)
                    d.hrp.AssemblyLinearVelocity = Vector3.zero
                end)
                local bp = Instance.new("BodyPosition")
                bp.MaxForce = Vector3.new(1e19, 1e19, 1e19)
                bp.P = 1e19
                bp.Position = Vector3.new(x, h, z)
                bp.Parent = d.hrp
                task.delay(2, function() pcall(function() bp:Destroy() end) end)
                task.wait()
