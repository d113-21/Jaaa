local function safeWait(p, n, t)
    if not p then return nil end
    local ok, r = pcall(function() return p:WaitForChild(n, t or 5) end)
    if ok then return r end
    return nil
end

local CE = safeWait(ReplicatedStorage, "CharacterEvents", 5)
local PlayerEvents = safeWait(ReplicatedStorage, "PlayerEvents", 3)
local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")

local SetNetworkOwner = nil
local SpawnToyRemote = nil
local DestroyToyRemote = nil
for _, v in pairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        if v.Name == "SetNetworkOwner" then SetNetworkOwner = v
        elseif v.Name == "DestroyToy" then DestroyToyRemote = v end
    elseif v:IsA("RemoteFunction") and v.Name == "SpawnToyRemoteFunction" then
        SpawnToyRemote = v
    end
end

local stickyEvent = PlayerEvents and PlayerEvents:FindFirstChild("StickyPartEvent")

local function notify(t, c, d) pcall(function() Rayfield:Notify({Title=t or "通知", Content=c or "", Duration=d or 4}) end) end

local function getTargetContainer(plr)
    if not workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then
        return workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
    end
    for _, v in pairs(workspace.Plots:GetChildren()) do
        local sign = v:FindFirstChild("PlotSign")
        local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
        if owners then
            for _, b in pairs(owners:GetChildren()) do
                if b.Value == plr.Name then
                    local folder = workspace.PlotItems:FindFirstChild(v.Name)
                    if folder then return folder end
                end
            end
        end
    end
    return workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
end

local function spawnAndAttachShuriken(targetPart, container)
    if not targetPart or not container then return nil end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
    if not canSpawn or not canSpawn.Value or not SpawnToyRemote then return nil end
    local pre = {}
    for _, c in pairs(container:GetChildren()) do
        if c.Name == "NinjaShuriken" then table.insert(pre, c) end
    end
    local ok, sh = pcall(function()
        SpawnToyRemote:InvokeServer("NinjaShuriken", hrp.CFrame * CFrame.new(0, 2, 8), Vector3.new(0,0,0))
        local st = tick()
        while tick() - st < 2 do
            for _, c in pairs(container:GetChildren()) do
                if c.Name == "NinjaShuriken" and not table.find(pre, c) then return c end
            end
            task.wait()
        end
        return nil
    end)
    if not ok or not sh then return nil end
    local sp = sh:FindFirstChild("SoundPart") or sh:WaitForChild("SoundPart", 0.1)
    if sp and SetNetworkOwner then pcall(function() SetNetworkOwner:FireServer(sp, sp.CFrame) end) end
    if sh:FindFirstChild("StickyPart") and stickyEvent then
        pcall(function()
            stickyEvent:FireServer(sh.StickyPart, targetPart,
                CFrame.new(9.99999996e+11, 9.99999996e+11, 9.99999996e+11, 1, 0, 0, 0, 1, 0, 0, 0, 1))
        end)
    end
    return sh
end

local function destroyShuriken(sh)
    if sh and sh.Parent and DestroyToyRemote then
        pcall(function() DestroyToyRemote:FireServer(sh) end)
    end
end

