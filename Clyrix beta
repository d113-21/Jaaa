                    if child:IsA("BasePart") then child.CanCollide = false end
                end
                local BG, BP = SetupBHPhysics(part)
                local angleOffset = ((i - 1) / total) * math.pi * 2

                table.insert(BlackHole.Toys, {
                    part        = part,
                    model       = toyModel,
                    BP          = BP,
                    BG          = BG,
                    angleOffset = angleOffset,
                })
            end
        end
        return true
    end

    local function StartBlackHoleAnimation()
        if BlackHole.RunConnection then
            pcall(function() BlackHole.RunConnection:Disconnect() end)
        end

        BlackHole.RunConnection = RunService.RenderStepped:Connect(function(dt)
            if not BlackHole.isActive or #BlackHole.Toys == 0 then return end
            local char = ToyLocalPlayer.Character
            if not char then return end
            local head = char:FindFirstChild("Head")
            if not head then return end

            local centerPos = head.Position + Vector3.new(0, BlackHole.HeadOffsetY, 0)
            BlackHole.TimeCounter = BlackHole.TimeCounter + dt * BlackHole.OrbitSpeed * BlackHole.Direction

            for _, toy in ipairs(BlackHole.Toys) do
                if toy.part and toy.part.Parent then
                    local angle = BlackHole.TimeCounter + toy.angleOffset
                    local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
                    local worldPos = centerPos + outward * BlackHole.RingRadius
                    local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * BlackHole.Direction
                    
                    local baseCF = CFrame.lookAt(worldPos, worldPos + tangent, Vector3.new(0, 1, 0))
                    local finalCF = baseCF * CFrame.Angles(
                        math.rad(BlackHole.ToyOffsetX), 
                        math.rad(BlackHole.ToyOffsetY), 
                        math.rad(BlackHole.ToyOffsetZ)
                    )

                    pcall(function()
                        toy.BP.P = BlackHole.PhysicsP
                        toy.BG.P = BlackHole.PhysicsP
                        toy.BP.Position = worldPos
                        toy.BG.CFrame = finalCF
                    end)
                end
            end
        end)
    end

    local function ToggleBlackHole(enabled)
        if enabled then
            if BuildBlackHole() then
                BlackHole.isActive = true
                StartBlackHoleAnimation()
                ToyNotify("Black Hole", "Activated", 3)
            else
                BlackHole.isActive = false
            end
        else
            BlackHole.isActive = false
            CleanupBlackHole(true)
            ToyNotify("Black Hole", "Deactivated (toys dropped)", 3)
        end
    end

    -- ★ 安全対策：ToyLocalPlayer が存在する場合のみ監視する
    if ToyLocalPlayer then
        ToyLocalPlayer.CharacterAdded:Connect(function()
            if BlackHole.isActive then
