    DanceV2.startHipDanceV2 = function(arg)
        if not DanceV2.activeDanceDataV2 then return end
        DanceV2.stopHipDanceV2(arg)

        local hrp = arg:WaitForChild("HumanoidRootPart")
        local hum = arg:WaitForChild("Humanoid")
        if not hrp or not hum then return end

        if DanceV2.RagdollRemote then
            pcall(function() DanceV2.RagdollRemote:FireServer(hrp, 9999999) end)
        else
            hum.PlatformStand = true
            hum.AutoRotate   = false
        end

        local position  = hrp.Position
        local walkSpeed = hum.WalkSpeed > 0 and hum.WalkSpeed or 16
        local total     = #DanceV2.activeDanceDataV2.frames
        if total == 0 then return end

        DanceV2.frameIndexV2 = 1
        DanceV2.frameTimerV2 = 0

        local function parse(d)
            return CFrame.new(d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11], d[12])
        end

        DanceV2.poseConnectionV2 = DanceV2.RunService.Heartbeat:Connect(function(dt)
            if not arg or not arg.Parent or not hrp or not hrp.Parent then return end

            local look = DanceV2.camera.CFrame.LookVector
            local yaw  = math.atan2(-look.X, -look.Z)
            local p2   = hrp.Position
            if 8 < (p2 - position).Magnitude then position = p2 end
            local md = hum.MoveDirection
            if md.Magnitude > 0.01 then position = position + md * walkSpeed * dt end

            local baseCF = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
            hrp.CFrame = baseCF
            hrp.AssemblyLinearVelocity = Vector3.zero

            DanceV2.frameTimerV2 = DanceV2.frameTimerV2 + dt
            local wrapped = false
            if DanceV2.activeDanceDataV2.interval <= DanceV2.frameTimerV2 then
                DanceV2.frameTimerV2 = DanceV2.frameTimerV2 - DanceV2.activeDanceDataV2.interval
                DanceV2.frameIndexV2 = DanceV2.frameIndexV2 + 1
                if total < DanceV2.frameIndexV2 then
                    DanceV2.frameIndexV2 = 1
                    wrapped = true
                end
            end

            local cur   = DanceV2.activeDanceDataV2.frames[DanceV2.frameIndexV2]
            local nxt   = DanceV2.activeDanceDataV2.frames[DanceV2.frameIndexV2 < total and DanceV2.frameIndexV2 + 1 or 1]
            local alpha = wrapped and 1 or (DanceV2.frameTimerV2 / DanceV2.activeDanceDataV2.interval)

            for name, data in pairs(cur.parts) do
                if not SKIP_PARTS[name] then
                    local part = arg:FindFirstChild(name)
                    if part and part:IsA("BasePart") then
                        local nd = nxt.parts[name] or data
                        part.CFrame = baseCF * parse(data):Lerp(parse(nd), alpha)
                        part.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end)
    end

    DanceV2.refreshDanceV2List = function()
        DanceV2.currentDanceRawTableV2 = {}

        local ok, raw = pcall(function()
            return game:HttpGet(DANCE_LIST_URL)
        end)

        if ok and type(raw) == "string" and #raw > 0 then
            local ok2, tbl = pcall(function()
                local chunk = loadstring(raw)
                if chunk then return chunk() end
            end)

            if ok2 and type(tbl) == "table" then
                for name, jsonStr in pairs(tbl) do
                    if type(name) == "string" and type(jsonStr) == "string" then
                        DanceV2.currentDanceRawTableV2[name] = jsonStr
                    end
                end
            end
        end

        pcall(function()
            if not isfolder("PoopHub") then makefolder("PoopHub") end
            if not isfolder("PoopHub/FTAP") then makefolder("PoopHub/FTAP") end
            if not isfolder("PoopHub/FTAP/Emote") then makefolder("PoopHub/FTAP/Emote") end

            local ok3, files = pcall(function() return listfiles("PoopHub/FTAP/Emote") end)
            if ok3 and type(files) == "table" then
                for _, path in ipairs(files) do
                    if path:match("%.dance$") then
                        local name = path:gsub("\\", "/"):match("([^/]+)%.dance$")
                        if name then
                            local ok4, content = pcall(function() return readfile(path) end)
                            if ok4 and content then
                                DanceV2.currentDanceRawTableV2[name] = content
                            end
                        end
                    end
                end
            end
        end)

        table.clear(DanceV2.danceListV2)
        for k in pairs(DanceV2.currentDanceRawTableV2) do
            table.insert(DanceV2.danceListV2, k)
        end
        table.sort(DanceV2.danceListV2)

        if #DanceV2.danceListV2 == 0 then
            table.insert(DanceV2.danceListV2, "No dances found")
        end

        return DanceV2.danceListV2
    end

