        local world = Instance.new("WorldModel")
        world.Parent = view

        local cam = Instance.new("Camera")
        cam.FieldOfView = 40
        cam.Parent = view
        view.CurrentCamera = cam

        -- Groupbox 内へ挿入
        do
            local lbl = Target3DGroup:AddLabel("")
