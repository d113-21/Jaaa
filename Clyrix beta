-- Player Information（Main タブ右側）
-- =====================================================
do
    local InfoGroup = Tabs.MainTab:AddRightGroupbox("Player Information", "info")
    local DisplayNameLabel = InfoGroup:AddLabel("Display Name: -")
    local PlayerIdLabel    = InfoGroup:AddLabel("Player ID: -")
    local PlayTimeLabel    = InfoGroup:AddLabel("Play Time: -")
    local PositionLabel    = InfoGroup:AddLabel("Position: -")
    local BlockLabel       = InfoGroup:AddLabel("Under Block: -")

    local function setLabel(label, text)
        if not label then return end
        if typeof(label) == "table" and label.SetText then
            pcall(function() label:SetText(text) end)
        elseif typeof(label) == "Instance" and label:IsA("TextLabel") then
            label.Text = text
        end
    end

    local startTime = tick()

    local function formatTime(seconds)
        seconds = math.floor(seconds)
        local h = math.floor(seconds / 3600)
        local m = math.floor((seconds % 3600) / 60)
        local s = seconds % 60
        return string.format("%02d:%02d:%02d", h, m, s)
    end

    local function getBlockUnderFeet()
        local char = LocalPlayer.Character
        if not char then return "-" end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return "-" end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local result = Workspace:Raycast(hrp.Position, Vector3.new(0, -1, 0) * 500, params)
        if result and result.Instance then
            return result.Instance.Name
        end
        return "-"
    end

    task.spawn(function()
        while task.wait(0.2) do
            pcall(function()
                setLabel(DisplayNameLabel, "Display Name: " .. tostring(LocalPlayer.DisplayName))
                setLabel(PlayerIdLabel, "Player ID: @" .. tostring(LocalPlayer.Name))
                setLabel(PlayTimeLabel, "Play Time: " .. formatTime(tick() - startTime))

                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local p = hrp.Position
                    setLabel(PositionLabel, string.format("Position: X=%.1f, Y=%.1f, Z=%.1f", p.X, p.Y, p.Z))
                else
                    setLabel(PositionLabel, "Position: -")
                end

                setLabel(BlockLabel, "Under Block: " .. getBlockUnderFeet())
            end)
        end
    end)
end

