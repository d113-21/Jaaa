local function skySnapshotOriginal()
    if skyOriginal then return end
    skyOriginal = {
        Brightness = SkyLightingSvc.Brightness, ClockTime = SkyLightingSvc.ClockTime,
        FogColor = SkyLightingSvc.FogColor, FogStart = SkyLightingSvc.FogStart, FogEnd = SkyLightingSvc.FogEnd,
        Ambient = SkyLightingSvc.Ambient, OutdoorAmbient = SkyLightingSvc.OutdoorAmbient,
    }
    local atmos = SkyLightingSvc:FindFirstChildOfClass("Atmosphere")
    if atmos then
        skyOriginal.AtmosRef = atmos
        skyOriginal.AtmosDensity = atmos.Density; skyOriginal.AtmosOffset = atmos.Offset
        skyOriginal.AtmosColor = atmos.Color; skyOriginal.AtmosDecay = atmos.Decay
        skyOriginal.AtmosGlare = atmos.Glare; skyOriginal.AtmosHaze = atmos.Haze
    end
end

local function skyDestroyCustom()
    if skyCurrentSky then pcall(function() skyCurrentSky:Destroy() end) skyCurrentSky = nil end
    if skyCurrentCC then pcall(function() skyCurrentCC:Destroy() end) skyCurrentCC = nil end
    if skyCurrentAtmosCustom then pcall(function() skyCurrentAtmosCustom:Destroy() end) skyCurrentAtmosCustom = nil end
end

local function skyApplyPreset(name)
    local p = SkyPresets[name]
    if not p then return end
    skyActivePresetName = name
    skySnapshotOriginal()
    skyDestroyCustom()

    local sky = Instance.new("Sky")
    sky.Name = "_SkyChanger"
    sky.SkyboxBk = p.SkyboxBk; sky.SkyboxDn = p.SkyboxDn; sky.SkyboxFt = p.SkyboxFt
    sky.SkyboxLf = p.SkyboxLf; sky.SkyboxRt = p.SkyboxRt; sky.SkyboxUp = p.SkyboxUp
    sky.SunAngularSize = 12; sky.MoonAngularSize = 10; sky.StarCount = 3000
    sky.Parent = SkyLightingSvc
    skyCurrentSky = sky

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "_SkyCC"
    cc.TintColor = p.CCTint; cc.Saturation = p.CCSaturation
    cc.Contrast = p.CCContrast; cc.Brightness = p.CCBrightness
    cc.Parent = SkyLightingSvc
    skyCurrentCC = cc

    local atmos = SkyLightingSvc:FindFirstChildOfClass("Atmosphere")
    if atmos then
        atmos.Density = p.AtmosDensity; atmos.Offset = p.AtmosOffset
        atmos.Color = p.AtmosColor; atmos.Decay = p.AtmosDecay
        atmos.Glare = p.AtmosGlare; atmos.Haze = p.AtmosHaze
    else
        local a = Instance.new("Atmosphere")
        a.Name = "_SkyAtmos"
        a.Density = p.AtmosDensity; a.Offset = p.AtmosOffset
        a.Color = p.AtmosColor; a.Decay = p.AtmosDecay
        a.Glare = p.AtmosGlare; a.Haze = p.AtmosHaze
        a.Parent = SkyLightingSvc
        skyCurrentAtmosCustom = a
    end
end

local function skyStartEnforce()
    if skyEnforceConn then skyEnforceConn:Disconnect() end
    skyEnforceConn = SkyRService.Heartbeat:Connect(function()
        if not skyEnabled or not skyActivePresetName then return end
        local p = SkyPresets[skyActivePresetName]
        if not p then return end
        pcall(function()
            for _, inst in ipairs(SkyLightingSvc:GetChildren()) do
                if inst:IsA("Sky") and inst ~= skyCurrentSky and inst.Enabled then inst.Enabled = false end
            end
            if skyCurrentSky and skyCurrentSky.Parent ~= SkyLightingSvc then skyCurrentSky.Parent = SkyLightingSvc end
            if skyCurrentCC and skyCurrentCC.Parent ~= SkyLightingSvc then skyCurrentCC.Parent = SkyLightingSvc end
            SkyLightingSvc.Brightness = p.Brightness; SkyLightingSvc.ClockTime = p.ClockTime
            SkyLightingSvc.FogColor = p.FogColor; SkyLightingSvc.FogStart = p.FogStart; SkyLightingSvc.FogEnd = p.FogEnd
            SkyLightingSvc.Ambient = p.Ambient; SkyLightingSvc.OutdoorAmbient = p.OutdoorAmbient
        end)
    end)
end

local function skyStopEnforce()
    if skyEnforceConn then skyEnforceConn:Disconnect() skyEnforceConn = nil end
end

local function skyRestoreOriginal()
    skyStopEnforce()
    skyDestroyCustom()
    if skyOriginal then
        pcall(function()
            SkyLightingSvc.Brightness = skyOriginal.Brightness
            SkyLightingSvc.ClockTime = skyOriginal.ClockTime
            SkyLightingSvc.FogColor = skyOriginal.FogColor
            SkyLightingSvc.FogStart = skyOriginal.FogStart
            SkyLightingSvc.FogEnd = skyOriginal.FogEnd
            SkyLightingSvc.Ambient = skyOriginal.Ambient
            SkyLightingSvc.OutdoorAmbient = skyOriginal.OutdoorAmbient
        end)
        if skyOriginal.AtmosRef and skyOriginal.AtmosRef.Parent then
            pcall(function()
                skyOriginal.AtmosRef.Density = skyOriginal.AtmosDensity; skyOriginal.AtmosRef.Offset = skyOriginal.AtmosOffset
                skyOriginal.AtmosRef.Color = skyOriginal.AtmosColor; skyOriginal.AtmosRef.Decay = skyOriginal.AtmosDecay
                skyOriginal.AtmosRef.Glare = skyOriginal.AtmosGlare; skyOriginal.AtmosRef.Haze = skyOriginal.AtmosHaze
            end)
        end
    end
    for _, inst in ipairs(SkyLightingSvc:GetChildren()) do if inst:IsA("Sky") then inst.Enabled = true end end
    skyActivePresetName = nil
end

