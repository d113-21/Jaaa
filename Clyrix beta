    local function ToyNotify(title, text, duration)
        Library:Notify({Title = title, Description = text, Time = duration or 3})
    end

    -- ============================================================
    -- WingMaster Logic
    -- ============================================================
    local WingMaster = {}
    WingMaster.isActive       = false
    WingMaster.SelectedItem   = "TetracubeI"
    WingMaster.SearchMode     = "My Toys"

    -- Flapping
    WingMaster.WingSpeed      = 2
