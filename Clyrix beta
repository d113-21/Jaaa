task.defer(function()
    local success, err = pcall(function()
        local BaseDeleteGroup = Tabs.ServerTab:AddRightGroupbox("base block delete")

        local AutoGroundBreakEnabled = false
        local clickConnection_Ground = nil
        local groundSpawnedShurikens = {}

        -- 実際の処理
        local function spawnAndBreakPart(targetPart)
            if not targetPart or targetPart:IsA("Terrain") then return end
            
            local replicatedStorage = game:GetService("ReplicatedStorage")
            local PlayerEvents = replicatedStorage:FindFirstChild("PlayerEvents")
            local stickyEvent = PlayerEvents and PlayerEvents:FindFirstChild("StickyPartEvent")
            local SpawnToyRemote = nil
            local SetNetworkOwner = nil
            local DestroyToy = nil
            
            for _, v in pairs(replicatedStorage:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    if v.Name == "SetNetworkOwner" then SetNetworkOwner = v
                    elseif v.Name == "DestroyToy" then DestroyToy = v end
                elseif v:IsA("RemoteFunction") and v.Name == "SpawnToyRemoteFunction" then
                    SpawnToyRemote = v
                end
            end

            if not stickyEvent or not SpawnToyRemote then
                Library:Notify({Title = "Error", Description = "Required Remotes not found.", Time = 3})
                return
            end

            local plr = game:GetService("Players").LocalPlayer
            local canSpawn = plr:FindFirstChild("CanSpawnToy")
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local inv = workspace:FindFirstChild(plr.Name.."SpawnedInToys") or workspace
            local preExisting = {}
            for _, child in pairs(inv:GetChildren()) do
                if child.Name == "NinjaShuriken" then table.insert(preExisting, child) end
            end

            if (not canSpawn or canSpawn.Value) then
                pcall(function()
                    SpawnToyRemote:InvokeServer("NinjaShuriken", hrp.CFrame * CFrame.new(0, 2, 8), Vector3.new(0,0,0))
                end)

                local newShuriken = nil
                local searchStart = tick()
                while tick() - searchStart < 2 do
                    for _, child in pairs(inv:GetChildren()) do
                        if child.Name == "NinjaShuriken" and not table.find(preExisting, child) then
                            newShuriken = child
                            break
                        end
                    end
                    if newShuriken then
                        if SetNetworkOwner then
                            local soundPart = newShuriken:FindFirstChild("SoundPart") or newShuriken:WaitForChild("SoundPart", 0.1)
                            if soundPart then
                                pcall(function() SetNetworkOwner:FireServer(soundPart, soundPart.CFrame) end)
                            end
                        end
                        break
                    end
                    task.wait()
                end

                if newShuriken and newShuriken:FindFirstChild("StickyPart") then
                    table.insert(groundSpawnedShurikens, newShuriken)
                    pcall(function()
                        stickyEvent:FireServer(
                            newShuriken.StickyPart,
                            targetPart,
                            CFrame.new(9.99999996e+11, 9.99999996e+11, 9.99999996e+11, 1, 0, 0, 0, 1, 0, 0, 0, 1)
                        )
                    end)
                end
            end
        end

        local function cleanupGroundShurikens()
            local replicatedStorage = game:GetService("ReplicatedStorage")
            local DestroyToy = nil
            for _, v in pairs(replicatedStorage:GetDescendants()) do
                if v:IsA("RemoteEvent") and v.Name == "DestroyToy" then DestroyToy = v break end
            end
            if DestroyToy then
                for _, shuriken in pairs(groundSpawnedShurikens) do
                    if shuriken and shuriken.Parent then
                        pcall(function() DestroyToy:FireServer(shuriken) end)
                    end
                end
            end
            groundSpawnedShurikens = {}
        end

        BaseDeleteGroup:AddToggle("FootGroundBreak", {
            Text = "Foot",
            Default = false,
            Callback = function(Value)
                AutoGroundBreakEnabled = Value
                if AutoGroundBreakEnabled then
                    task.spawn(function()
                        while AutoGroundBreakEnabled do
                            local character = game:GetService("Players").LocalPlayer.Character
                            local hrp = character and character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterDescendantsInstances = {character}
                                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -10, 0), rayParams)
                                local targetPart = rayResult and rayResult.Instance
                                if targetPart and targetPart:IsA("BasePart") and not targetPart:IsA("Terrain") then
                                    spawnAndBreakPart(targetPart)
                                end
                            end
                            task.wait(0.8)
                        end
                    end)
                else
                    cleanupGroundShurikens()
                end
            end,
        })

        BaseDeleteGroup:AddToggle("TapGroundBreak", {
            Text = "Tap",
            Default = false,
            Callback = function(Value)
                if Value then
                    local mouse = game:GetService("Players").LocalPlayer:GetMouse()
                    if mouse then
                        clickConnection_Ground = mouse.Button1Down:Connect(function()
                            local targetPart = mouse.Target
                            if targetPart and targetPart:IsA("BasePart") and not targetPart:IsA("Terrain") then
                                spawnAndBreakPart(targetPart)
                            end
                        end)
                    end
                else
                    if clickConnection_Ground then
                        clickConnection_Ground:Disconnect()
                        clickConnection_Ground = nil
                    end
                    cleanupGroundShurikens()
                end
            end,
        })
    end)
    
    if not success then
        warn("[Clyrix] Base Block Delete Error: " .. tostring(err))
    end
end)

