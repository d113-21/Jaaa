    local function StripPhysicsFromToys()
        local folders = GetToyFolders()
        for _, folder in ipairs(folders) do
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart") then
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA("BodyPosition") or child:IsA("BodyGyro") then
                            pcall(function() child:Destroy() end)
                        end
                    end
                end
            end
        end
    end

    local function CleanupWings(dropToys)
        for _, w in pairs(WingMaster.Wings) do
            if w.Handle and w.Handle.Parent then
                pcall(function() w.Handle:Destroy() end)
            end
            for _, s in pairs(w.Segments or {}) do
                if s.Part and s.Part.Parent then
                    pcall(function() s.Part:Destroy() end)
                end
            end
            if dropToys then
                local function strip(entry)
                    if entry then
                        if entry.BP then pcall(function() entry.BP:Destroy() end) end
                        if entry.BG then pcall(function() entry.BG:Destroy() end) end
                    end
                end
                strip(w.Reserved)
                for _, sync in pairs(w.Sync or {}) do
                    strip(sync)
                end
            end
        end
        WingMaster.Wings = {}
        if WingMaster.RunConnection then
            pcall(function() WingMaster.RunConnection:Disconnect() end)
            WingMaster.RunConnection = nil
        end
        if dropToys then
            pcall(StripPhysicsFromToys)
        end
    end

    local function SetupPhysics(part)
        local BP = part:FindFirstChildOfClass("BodyPosition") or Instance.new("BodyPosition")
        local BG = part:FindFirstChildOfClass("BodyGyro") or Instance.new("BodyGyro")
        BP.P = WingMaster.PhysicsP
        BP.D = WingMaster.PhysicsD
        BP.MaxForce = Vector3.new(1, 1, 1) * 1e10
        BP.Parent = part
        BG.P = WingMaster.PhysicsP
        BG.D = WingMaster.PhysicsD
        BG.MaxTorque = Vector3.new(1, 1, 1) * 1e10
        BG.Parent = part
        return BG, BP
    end

    local function BuildWings()
        CleanupWings(false)
        local folders = GetToyFolders()
        local found = {}
        for _, folder in ipairs(folders) do
            for _, x in ipairs(folder:GetDescendants()) do
                if x:IsA("Model") and x.Name == WingMaster.SelectedItem then
                    table.insert(found, x)
                end
            end
        end

        if #found == 0 then
            ToyNotify("Wing Master", "Target item not found", 3)
            return false
        end

        for i = 1, 2 do
            local Segments = {}
            for x = 1, WingMaster.WingLength do
                local p = Instance.new("Part")
                p.CanCollide = false; p.Anchored = true; p.Transparency = 1
                p.Size = Vector3.new(4, 1, 4)
                p.Parent = ToyWorkspace
                Segments[#Segments + 1] = { Part = p }
            end
            local h = Instance.new("Part")
            h.CanCollide = false; h.Anchored = true; h.Transparency = 1
            h.Size = Vector3.new(4, 1, 4)
            h.Parent = ToyWorkspace
            WingMaster.Wings[#WingMaster.Wings + 1] = {
                Handle = h, Segments = Segments, Sync = {}, Reserved = nil,
            }
        end

        for i, v in ipairs(found) do
            local Side = (i <= (#found / 2)) and 1 or 2
            local Pallet = v:FindFirstChild("SoundPart") or v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
            if Pallet then
                for _, child in pairs(v:GetChildren()) do
                    if child:IsA("BasePart") then child.CanCollide = false end
                end
                local BG, BP = SetupPhysics(Pallet)
                if not WingMaster.Wings[Side].Reserved then
                    WingMaster.Wings[Side].Reserved = { BG = BG, BP = BP }
                else
                    table.insert(WingMaster.Wings[Side].Sync, { BG = BG, BP = BP })
                end
            end
        end
        return true
    end

    local function StartWingAnimation()
        if WingMaster.RunConnection then
            pcall(function() WingMaster.RunConnection:Disconnect() end)
        end
        WingMaster.RunConnection = ToyRunService.RenderStepped:Connect(function(dt)
            if not WingMaster.isActive or #WingMaster.Wings == 0 then return end
            local char = ToyLocalPlayer.Character
            if not char or not char:FindFirstChild("Torso") then return end

            local torso = char.Torso
            local hrp   = char:FindFirstChild("HumanoidRootPart")
            local vel   = hrp and hrp.Velocity.Magnitude or 0

            WingMaster.TimeCounter = WingMaster.TimeCounter + dt * (WingMaster.WingSpeed + vel / 40) * WingMaster.FlapMultiplier
            local offsets = GetWingOffsets()

            for i, Wing in ipairs(WingMaster.Wings) do
                local direction = (i == 1) and 1 or -1
                local flap = math.sin(WingMaster.TimeCounter) * math.rad(WingMaster.WingAngle + vel / 4) * direction

                Wing.Handle.CFrame = torso.CFrame * offsets[i] * CFrame.Angles(0, 0, flap)

                if Wing.Reserved then
                    pcall(function()
                        Wing.Reserved.BP.P = WingMaster.PhysicsP
                        Wing.Reserved.BG.P = WingMaster.PhysicsP
                        Wing.Reserved.BP.Position = Wing.Handle.Position
                        Wing.Reserved.BG.CFrame = Wing.Handle.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90))
                    end)
                end

                for Index, Segment in ipairs(Wing.Segments) do
                    local ToFollow = (Index == 1) and Wing.Handle.CFrame or Wing.Segments[Index - 1].Part.CFrame
                    Segment.Part.CFrame = Segment.Part.CFrame:Lerp(ToFollow * offsets[i], WingMaster.SyncWeight)
                    if Wing.Sync[Index] then
                        pcall(function()
                            Wing.Sync[Index].BP.P = WingMaster.PhysicsP
                            Wing.Sync[Index].BG.P = WingMaster.PhysicsP
                            Wing.Sync[Index].BP.Position = Segment.Part.Position
                            Wing.Sync[Index].BG.CFrame = Segment.Part.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90))
                        end)
                    end
                end
            end
        end)
    end

    local function ToggleWingMaster(enabled)
        if enabled then
            if BuildWings() then
                WingMaster.isActive = true
                StartWingAnimation()
                ToyNotify("Wing Master", "Activated", 3)
            else
