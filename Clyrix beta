            if (ap - movePos).Magnitude > 8 then movePos = ap end
            local md = humanoid.MoveDirection
            if md.Magnitude > 0.01 then movePos = movePos + md * walkSpeed * dt end
            local target = CFrame.new(movePos) * CFrame.Angles(0, yaw, 0)
            rootPart.CFrame = target
            local lc = lolTime * 4
            local li = math.abs(math.sin(lc))
            local leanBack = math.rad(-15 - li*30)
            local bounce = li * 0.3
            local headTilt = math.rad(10 + li*25)
            local armsFwd = -1.5 + li*0.3
            local legSpread = 0.3 + li*0.3
            local offsets = {
                Torso = CFrame.new(0,bounce,li*0.3) * CFrame.Angles(leanBack,0,0),
                Head = CFrame.new(0,1.5+bounce,-li*0.4) * CFrame.Angles(headTilt, math.rad(math.sin(lc*2)*15), math.rad(math.sin(lc*1.5)*8)),
                ["Left Arm"] = CFrame.new(-0.8,0.3+bounce*0.5,armsFwd) * CFrame.Angles(math.rad(-70+li*15),-0.26179938779914941,math.rad(-50-li*10)) * CFrame.new(0,-0.7,0),
                ["Right Arm"] = CFrame.new(0.8,0.3+bounce*0.5,armsFwd) * CFrame.Angles(math.rad(-70+li*15),0.26179938779914941,math.rad(-50-li*10)) * CFrame.new(0,-0.7,0),
                ["Left Leg"] = CFrame.new(-0.5-legSpread,-2+bounce*0.3,0) * CFrame.Angles(math.rad(li*10),math.rad(-legSpread*30),0),
                ["Right Leg"] = CFrame.new(0.5+legSpread,-2+bounce*0.3,0) * CFrame.Angles(math.rad(li*10),math.rad(legSpread*30),0),
            }
            for k, v in pairs(offsets) do
                local part = arg:FindFirstChild(k)
                if part and part:IsA("BasePart") then
                    part.CFrame = target * v
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end)
    end

    DanceV1.makeProceduralDance = function(arg)
        return function(arg2)
            DanceV1.stopPose()
            local rootPart = arg2:WaitForChild("HumanoidRootPart")
            local humanoid = arg2:WaitForChild("Humanoid")
            DanceV1.RagdollRemote:FireServer(rootPart, 9999999)
            local movePos = rootPart.Position
            local walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
            DanceV1.activeMode = "dance"
            DanceV1.poseConnection = DanceV1.RunService.Heartbeat:Connect(function(dt)
                if not arg2.Parent or not rootPart.Parent then DanceV1.stopPose() return end
                local t = tick()
                local look = DanceV1.camera.CFrame.LookVector
                local yaw = math.atan2(-look.X, -look.Z)
                local ap = rootPart.Position
                if (ap - movePos).Magnitude > 8 then movePos = ap end
                local md = humanoid.MoveDirection
                if md.Magnitude > 0.01 then movePos = movePos + md * walkSpeed * dt end
                local target = CFrame.new(movePos) * CFrame.Angles(0, yaw, 0)
                rootPart.CFrame = target
                local offsets = arg.pose(t * arg.speed)
                for k, v in pairs(offsets) do
                    local part = arg2:FindFirstChild(k)
                    if part and part:IsA("BasePart") then
                        part.CFrame = target * v
                        part.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end)
        end
    end

