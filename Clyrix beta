runDriftKick = function()
    local GE = DriftGrabEvents
    local blob = currentBlobman
    if not blob then return end
    local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
    local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
    local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
    local R_Det = blob:FindFirstChild("RightDetector")
    local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld"))
    if not blobRoot then return end
    local SavedPos = blobRoot.CFrame

    local target = selectedTargetPlayerObj
    if not target then return end
    local tChar = target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

    if tRoot and blobRoot then
        local bringStart = tick()
        while tick() - bringStart < bringDuration do
            if not masterEnabled or isPaused then break end
            blobRoot.CFrame = tRoot.CFrame
            blobRoot.Velocity = Vector3.zero
            pcall(function()
                if CG and R_Det then CG:FireServer(R_Det, tRoot, R_Weld) end
                GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
            end)
            RunService.Heartbeat:Wait()
        end
        blobRoot.CFrame = SavedPos
        blobRoot.Velocity = Vector3.zero
        task.wait(0.02)
    end

    local packetTimer = 0
    while masterEnabled and not isPaused do
        if not target or not target.Parent or not target.Character then break end
        if not blobRoot or not blobRoot.Parent then break end
        tChar = target.Character
        tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChild("Humanoid")
        if tRoot and tHum and tHum.Health > 0 then
            local lockPos = SavedPos * CFrame.new(0, lockHeight, 0)
            tRoot.CFrame = lockPos
            tRoot.Velocity = Vector3.zero
            tRoot.RotVelocity = Vector3.zero
            local dt = RunService.RenderStepped:Wait()
            orbitAngle = orbitAngle + (dt * orbitSpeed * speedMultiplier * 10)
            local orbitX = math.cos(orbitAngle) * orbitRadius
            local orbitZ = math.sin(orbitAngle) * orbitRadius
            local orbitCFrame = lockPos * CFrame.new(orbitX + bringDistanceZ, 0, orbitZ)
            local lookAtCFrame = CFrame.lookAt(orbitCFrame.Position, lockPos.Position)
            blobRoot.CFrame = lookAtCFrame
            blobRoot.Velocity = Vector3.zero
            if tick() - packetTimer > packetInterval then
                packetTimer = tick()
                pcall(function()
                    tHum.PlatformStand = true
                    tHum.Sit = true
                    GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                    if R_Det then
                        local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                        if weld then CD:FireServer(weld) end
                    end
                    GE.DestroyGrabLine:FireServer(tRoot)
                    if CG and R_Det then CG:FireServer(R_Det, tRoot, R_Weld) end
                    GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                end)
            end
        else
            if blobRoot and blobRoot.Parent then
                blobRoot.CFrame = SavedPos
                blobRoot.Velocity = Vector3.zero
            end
        end
        task.wait(0)
    end
    if blobRoot and blobRoot.Parent then
        blobRoot.CFrame = SavedPos
        blobRoot.Velocity = Vector3.zero
    end
end

runPalletRagdoll = function()
    local target = selectedTargetPlayerObj
    if not target or not target.Character then return end
    local RS = replicatedStorage
    local GE = DriftGrabEvents
    local skyPos = CFrame.new(0, 800000, 0)
    RS.MenuToys.SpawnToyRemoteFunction:InvokeServer("PalletLightBrown", skyPos, Vector3.zero)
    local pallet
    repeat
        pallet = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            and Workspace[LocalPlayer.Name .. "SpawnedInToys"]:FindFirstChild("PalletLightBrown")
        RunService.Heartbeat:Wait()
    until pallet or not masterEnabled or isPaused
    if not pallet then return end
    local mainPart = pallet:FindFirstChild("SoundPart") or pallet:FindFirstChildWhichIsA("BasePart")
    if not mainPart then return end
    mainPart.CanCollide = false
    mainPart.Anchored = false
    local function claim(part)
        GE.SetNetworkOwner:FireServer(part, part.CFrame)
        GE.CreateGrabLine:FireServer(part, Vector3.zero, part.Position, false)
        GE.DestroyGrabLine:FireServer(part)
    end
    claim(mainPart)
    while masterEnabled and not isPaused do
        if not target or not target.Parent or not target.Character then break end
        local root = target.Character:FindFirstChild("HumanoidRootPart")
            or target.Character:FindFirstChild("Torso")
            or target.Character:FindFirstChild("UpperTorso")
        if not root then RunService.Heartbeat:Wait(); continue end
        local targetPos = root.Position
        mainPart.CFrame = CFrame.new(targetPos + Vector3.new(0, aimHeight, 0))
        mainPart.AssemblyLinearVelocity = Vector3.zero
        mainPart.AssemblyAngularVelocity = Vector3.zero
        claim(mainPart)
        mainPart.CanCollide = false
        task.wait(aimWait)
        if root and target.Character then
            mainPart.CFrame = CFrame.new(root.Position)
            mainPart.AssemblyLinearVelocity = Vector3.new(0, smashVelocity, 0)
            mainPart.AssemblyAngularVelocity = Vector3.zero
            claim(mainPart)
            mainPart.CanCollide = true
        end
        task.wait(smashWait)
        if root and target.Character then
            mainPart.CFrame = CFrame.new(root.Position + Vector3.new(0, pullHeight, 0))
            mainPart.AssemblyLinearVelocity = Vector3.new(0, pullVelocity, 0)
            mainPart.AssemblyAngularVelocity = Vector3.zero
            claim(mainPart)
            mainPart.CanCollide = false
        end
        task.wait(pullWait)
    end
    if pallet and pallet.Parent then
        pcall(function() RS.MenuToys.DestroyToy:FireServer(pallet) end)
        pallet:Destroy()
    end
end

local function detachDeathMonitor()
    if deathMonitorTask then task.cancel(deathMonitorTask); deathMonitorTask = nil end
    if charAddedConn then pcall(function() charAddedConn:Disconnect() end); charAddedConn = nil end
    isPaused = false
end

local function attachDeathMonitor(target)
    detachDeathMonitor()
    isPaused = false
    deathMonitorTask = task.spawn(function()
        while masterEnabled do
            if target and target.Parent and target.Character then
                local char = target.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    if not isPaused then
                        isPaused = true
                        stopDriftFunctions()
                    end
                end
            end
            task.wait(0.1)
        end
    end)
    charAddedConn = target.CharacterAdded:Connect(function(newChar)
        if not masterEnabled then return end
        if not isPaused then return end
        task.wait(respawnDelay)
        if not masterEnabled then return end
        if selectedTargetPlayerObj ~= target then return end
        currentBlobman = findBlobman()
        if not currentBlobman or not isSittingOnBlobman() then
            masterEnabled = false
            if Toggles.DriftKickToggle then Toggles.DriftKickToggle:SetValue(false) end
            return
        end
        isPaused = false
        startDriftFunctions()
    end)
end

