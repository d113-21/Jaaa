    DanceV2.stopHipDanceV2 = function(arg)
        if DanceV2.poseConnectionV2 then
            pcall(function() DanceV2.poseConnectionV2:Disconnect() end)
            DanceV2.poseConnectionV2 = nil
        end
        if arg then
            local hum = arg:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function()
                    hum.PlatformStand = false
                    hum.AutoRotate = true
                end)
            end
        end
