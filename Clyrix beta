        { pathContains = { "Plots", "Plot5", "House" }, color = Color3.fromRGB(255, 130, 222), material = Enum.Material.Grass, id = TexIds.PinkGrass },
        { pathContains = { "Map", "CaveMountain", "House" }, classFilter = "WedgePart", color = Color3.fromRGB(39, 70, 45), material = Enum.Material.Plastic, id = TexIds.Moss },
        { pathContains = { "Map", "BarnHillArea", "Barn" }, color = Color3.fromRGB(148, 75, 75), material = Enum.Material.WoodPlanks, id = TexIds.Barn },
        { pathContains = { "Map", "BarnHillArea", "Farm", "FencedWheatField", "HighTensileFence" }, color = Color3.fromRGB(115, 107, 103), material = Enum.Material.Wood, id = TexIds.FenceWood },
        { pathContains = { "Map", "TrainTunnel", "TunnelTrainTracks", "TrackInvCom" }, color = Color3.fromRGB(99, 95, 98), material = Enum.Material.Metal, id = TexIds.TrackMetal },
    }

    local function ColorMatch(a, b, tol)
        local t = tol or (10 / 255)
        return math.abs(a.R - b.R) < t and math.abs(a.G - b.G) < t and math.abs(a.B - b.B) < t
    end

    local function GetFullPath(inst)
        local parts = {}
        local cur = inst
        while cur do
            table.insert(parts, 1, cur.Name)
            cur = cur.Parent
        end
        return table.concat(parts, ".")
    end

    local function PathContainsAll(inst, keywords)
        local path = GetFullPath(inst):lower()
        for _, kw in ipairs(keywords) do
            if not path:find(kw:lower(), 1, true) then return false end
        end
        return true
    end

    local function ResolveCornerWedge(inst)
        if not inst:IsA("CornerWedgePart") then return nil, nil end
        local nm = inst.Name:lower()
        for _, kw in ipairs({ "grass", "lawn", "turf", "ground" }) do
            if nm:find(kw) then return TexIds.GrassCorner end
        end
        return nil, nil
    end

    local function ResolveByPathColor(inst)
        for _, ov in ipairs(PathColorOverrides) do
            if PathContainsAll(inst, ov.pathContains) then
                local classOk = (ov.classFilter == nil) or inst:IsA(ov.classFilter)
                local colorOk = (ov.color == nil) or ColorMatch(inst.Color, ov.color)
                local matOk   = (ov.material == nil) or (inst.Material == ov.material)
                if classOk and colorOk and matOk then return ov.id end
            end
        end
        return nil, nil
    end

    local function ResolveByColorMaterial(inst)
        for _, ov in ipairs(ColorMaterialOverrides) do
            if inst.Material == ov.material and ColorMatch(inst.Color, ov.color) then
                return ov.id
            end
        end
        return nil, nil
    end

    local function ResolveByParentModel(inst)
        local parent = inst.Parent
        local depth = 0
        while parent and depth < 6 do
            if parent:IsA("Model") or parent:IsA("Folder") then
                local nm = parent.Name:lower()
                for _, ov in ipairs(ParentKeywords) do
                    for _, kw in ipairs(ov.keywords) do
                        if nm:find(kw) then return ov.id end
                    end
                end
            end
            parent = parent.Parent
            depth += 1
        end
        return nil, nil
    end

    local function ResolveByName(inst)
        local nm = inst.Name:lower()
        for _, ov in ipairs(NameKeywords) do
            for _, kw in ipairs(ov.keywords) do
                if nm:find(kw) then return ov.id end
            end
        end
        return nil, nil
    end

    local function Resolve(inst)
        local id = ResolveCornerWedge(inst)
        if id then return id end
        id = ResolveByPathColor(inst)
        if id then return id end
        id = ResolveByColorMaterial(inst)
        if id then return id end
        id = ResolveByParentModel(inst)
        if id then return id end
        return ResolveByName(inst)
    end

    local function ShouldSkipMCPart(inst)
        local path = GetFullPath(inst):lower()
        if inst.Name == "SNOWPART" then
            local p = inst.Parent
            if p and p:IsA("Model") and p.Name == "_PoophubSnowSystem" then return true end
        end
        for _, kw in ipairs({ "sky", "skybox", "cloud", "sun", "moon", "star" }) do
            if path:find(kw, 1, true) then return true end
        end
        return false
    end

    local function PasteFace(parent, face, texture)
        local t = Instance.new("Texture")
        t.Texture = texture
        t.Face = face
        t.StudsPerTileU = MCState.mcTileSize
        t.StudsPerTileV = MCState.mcTileSize
        t.Parent = parent
    end

    local function ApplyAllFaces(inst, texture)
        for _, face in ipairs({
            Enum.NormalId.Top, Enum.NormalId.Bottom,
            Enum.NormalId.Front, Enum.NormalId.Back,
            Enum.NormalId.Left, Enum.NormalId.Right,
        }) do
            PasteFace(inst, face, texture)
        end
    end

    local function ApplyMCTextures()
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("BasePart") and not inst:IsA("Terrain") then
                if not ShouldSkipMCPart(inst) then
                    local texId = Resolve(inst)
                    if texId and texId ~= TexIds.Snow then
                        if mcOriginalPartTextures[inst] == nil then
                            local saved = {}
                            for _, child in ipairs(inst:GetChildren()) do
                                if child:IsA("Texture") or child:IsA("Decal") then
                                    table.insert(saved, child:Clone())
                                    child:Destroy()
                                end
                            end
                            if #saved == 0 then saved = { "empty" } end
                            mcOriginalPartTextures[inst] = saved
                        else
                            for _, child in ipairs(inst:GetChildren()) do
                                if child:IsA("Texture") or child:IsA("Decal") then child:Destroy() end
                            end
                        end
                        ApplyAllFaces(inst, texId)
                    end
                end
            end
        end
    end

    local function RestoreOriginalTextures()
        for inst, saved in pairs(mcOriginalPartTextures) do
            if inst and inst.Parent then
                for _, child in ipairs(inst:GetChildren()) do
                    if child:IsA("Texture") or child:IsA("Decal") then child:Destroy() end
                end
                for _, entry in ipairs(saved) do
                    if entry ~= "empty" then entry:Clone().Parent = inst end
                end
            end
        end
        table.clear(mcOriginalPartTextures)
    end

    -- UI
    local MCGroup = Tabs.VisualsTab:AddLeftGroupbox("Minecraft Textures", "box")

    MCGroup:AddToggle("MCTexEnabled", {
        Text = "Enable Minecraft Textures",
        Default = false,
        Callback = function(value)
            MCState.mcTexturesEnabled = value
            if value then
                pcall(ApplyMCTextures)
            else
                pcall(RestoreOriginalTextures)
            end
        end,
    })

    MCGroup:AddSlider("MCTileSize", {
        Text = "Studs Per Tile",
        Default = 4, Min = 1, Max = 16, Rounding = 0, Suffix = " studs",
        Callback = function(value)
            MCState.mcTileSize = value
            for _, inst in ipairs(Workspace:GetDescendants()) do
                if inst:IsA("BasePart") then
                    for _, child in ipairs(inst:GetChildren()) do
                        if child:IsA("Texture") then
                            child.StudsPerTileU = value
                            child.StudsPerTileV = value
                        end
                    end
                end
            end
        end,
    })

    MCGroup:AddDivider()

    MCGroup:AddButton({
        Text = "Re-Apply Textures",
        Func = function()
            if MCState.mcTexturesEnabled then
                pcall(ApplyMCTextures)
            end
        end,
    })

    MCGroup:AddButton({
        Text = "Restore Original Textures",
        Func = function()
            pcall(RestoreOriginalTextures)
        end,
    })
end

