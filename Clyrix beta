    WingMaster.RunConnection  = nil

    local function GetWingOffsets()
        local ry = math.rad(WingMaster.BaseRotation)
        local tx = math.rad(WingMaster.BaseTiltX)
        return {
            CFrame.new(-WingMaster.OffsetX, WingMaster.OffsetY, WingMaster.OffsetZ) * CFrame.Angles(tx, ry, 0),
            CFrame.new( WingMaster.OffsetX, WingMaster.OffsetY, WingMaster.OffsetZ) * CFrame.Angles(tx, -ry, 0),
        }
    end

    local function GetToyFolders()
        local folders = {}
        if WingMaster.SearchMode == "My Toys" or WingMaster.SearchMode == "All Toys" then
