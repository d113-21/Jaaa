        { color = Color3.fromRGB(175, 148, 131), material = Enum.Material.WoodPlanks, id = TexIds.WoodBeige },
    }

    local PathColorOverrides = {
        { pathContains = { "Map", "FactoryIsland", "Chain" }, color = nil, material = nil, id = TexIds.Chain },
        { pathContains = { "Plots" }, color = Color3.fromRGB(152, 118, 84), material = Enum.Material.WoodPlanks, id = TexIds.PlotWood },
        { pathContains = { "Plots" }, color = Color3.fromRGB(255, 204, 153), material = Enum.Material.Plastic, id = TexIds.PlotSkin },
