local function SetIconState(newState, color)
    if iconState == newState then
        if newState == "play" then
            triangle.TextColor3 = color
        else
            bar1.BackgroundColor3 = color
            bar2.BackgroundColor3 = color
        end
        return
    end

    iconState = newState
    iconToken = iconToken + 1
    local token = iconToken

    if newState == "pause" then
        triangle.TextColor3 = color
        TweenService:Create(triangle, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Rotation = 90,
            TextTransparency = 1,
        }):Play()

        bar1.BackgroundColor3 = color
        bar2.BackgroundColor3 = color
        bar1.Position = UDim2.fromScale(0.5, 0.5)
        bar2.Position = UDim2.fromScale(0.5, 0.5)
        bar1.Size = UDim2.fromOffset(BAR_W, 0)
        bar2.Size = UDim2.fromOffset(BAR_W, 0)
        bar1.BackgroundTransparency = 0
        bar2.BackgroundTransparency = 0

        task.delay(0.1, function()
            if iconToken ~= token then return end
            TweenService:Create(bar1, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(BAR_W, BAR_H),
                Position = UDim2.new(0.5, -BAR_GAP, 0.5, 0),
            }):Play()
            TweenService:Create(bar2, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(BAR_W, BAR_H),
                Position = UDim2.new(0.5, BAR_GAP, 0.5, 0),
            }):Play()
        end)
    else
        TweenService:Create(bar1, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(BAR_W, 0),
            Position = UDim2.fromScale(0.5, 0.5),
            BackgroundTransparency = 1,
        }):Play()
        TweenService:Create(bar2, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(BAR_W, 0),
            Position = UDim2.fromScale(0.5, 0.5),
            BackgroundTransparency = 1,
        }):Play()

        triangle.TextColor3 = color
        triangle.Rotation = -90
        triangle.TextTransparency = 1
        task.delay(0.1, function()
            if iconToken ~= token then return end
            TweenService:Create(triangle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Rotation = 0,
                TextTransparency = 0,
            }):Play()
        end)
    end
end

