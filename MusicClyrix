local function SpawnSnowflake(parentFrame)
    local flake = Instance.new("Frame")
    flake.AnchorPoint = Vector2.new(0.5, 0.5)
    flake.BackgroundColor3 = Theme.Snow
    flake.BorderSizePixel = 0
    flake.BackgroundTransparency = 1
    flake.ZIndex = (parentFrame == snowLayer) and 50 or 6
    flake.Parent = parentFrame

    local size = math.random(2, 5)
    flake.Size = UDim2.fromOffset(size, size)

    local corner = Instance.new("UICorner", flake)
    corner.CornerRadius = UDim.new(1, 0)

    local startX = math.random(-10, 110) / 100
    local endX = startX + (math.random(-15, 15) / 100)
    local duration = math.random(35, 70) / 10
    local maxTransparency = math.random(20, 55) / 100

    flake.Position = UDim2.fromScale(startX, -0.05)
    flake.BackgroundTransparency = 1

    TweenService:Create(flake, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = maxTransparency,
    }):Play()

    local fall = TweenService:Create(flake, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.fromScale(endX, 1.05),
    })
    fall:Play()

    fall.Completed:Connect(function()
        flake:Destroy()
    end)
    task.delay(duration + 1, function()
        if flake and flake.Parent then flake:Destroy() end
    end)
end

task.spawn(function()
    while main and main.Parent do
        SpawnSnowflake(snowLayer)
