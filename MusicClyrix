-- ============================================================
-- URL/ID 解決
-- ============================================================
local function ResolveAssetId(input)
    if type(input) ~= "string" or input == "" then return nil end
    local s = input:match("^%s*(.-)%s*$")

    if s:find("github.com", 1, true) and s:find("/blob/", 1, true) then
        s = s:gsub("github%.com", "raw.githubusercontent.com"):gsub("/blob/", "/")
    end
    if s:match("^%d+$") then return "rbxassetid://" .. s end
    local id = s:match("^rbxassetid://(%d+)$")
    if id then return "rbxassetid://" .. id end
    if s:find("roblox.com", 1, true) then
        local found = s:match("[?&]id=(%d+)") or s:match("/asset/(%d+)") or s:match("/library/(%d+)")
        if found then return "rbxassetid://" .. found end
    end
    if s:match("^https?://") then
        if not (writefile and getcustomasset) then return nil end
        local ok, result = pcall(function()
            local ext = s:match("%.([%w]+)$") or "mp3"
            if ext ~= "mp3" and ext ~= "ogg" and ext ~= "wav" then ext = "mp3" end
            local fileName = "Music_" .. HttpService:GenerateGUID(false) .. "." .. ext
            local data = game:HttpGet(s)
            if not data or data == "" then error("DL fail") end
            writefile(fileName, data)
            local asset = getcustomasset(fileName)
            task.delay(5, function()
                if delfile then pcall(delfile, fileName) end
            end)
            return asset
        end)
        if ok then return result end
    end
    return nil
end

-- ============================================================
-- 再生処理
-- ============================================================
local UI

local function DestroySound()
    if State.Sound then
        pcall(function()
            State.Sound:Stop()
            State.Sound:Destroy()
        end)
        State.Sound = nil
    end
    State.PlayingIndex = 0
    State.IsPaused = false
    State.IsLoading = false
    if UI then UI.RefreshList(); UI.UpdatePlayButton(); UI.SetNowPlaying("") end
end

local function PauseSound()
    if State.Sound and not State.IsPaused then
        State.Sound:Pause()
        State.IsPaused = true
        if UI then UI.UpdatePlayButton() end
    end
end

local function ResumeSound()
    if State.Sound and State.IsPaused then
        State.Sound:Resume()
        State.IsPaused = false
        if UI then UI.UpdatePlayButton() end
    end
end

local function PlayIndex(idx)
    local entry = Songs[idx]
    if not entry then return end
    if entry.Asset == "" then
        if UI then UI.Notify("曲が未設定です") end
        return
    end

    local assetId = ResolveAssetId(entry.Asset)
    if not assetId then
        if UI then UI.Notify("アセット解決失敗") end
        return
    end

    DestroySound()

    State.IsLoading = true
    State.PlayingIndex = idx
    if UI then UI.RefreshList(); UI.UpdatePlayButton(); UI.SetNowPlaying(entry.Name) end

    local sound = Instance.new("Sound")
    sound.Name = "MusicPlayerSound"
    sound.SoundId = assetId
    sound.Volume = State.Volume
    sound.Looped = true
    sound.Parent = SoundService

    State.Sound = sound
    State.IsPaused = false
    State.LoadingId = State.LoadingId + 1
    local myId = State.LoadingId

    local loaded = false
    local conn
    conn = sound.Loaded:Connect(function()
        loaded = true
        if conn then conn:Disconnect() end
        if State.LoadingId == myId then
            State.IsLoading = false
            if UI then UI.UpdatePlayButton() end
        end
    end)

    sound:Play()

    task.delay(3, function()
        if State.LoadingId == myId and State.Sound == sound and not loaded and sound.TimeLength == 0 then
            State.IsLoading = false
            if UI then UI.UpdatePlayButton() end
        end
    end)
end

local function PlaySelected()
    if State.SelectedIndex == 0 then
        if UI then UI.Notify("曲を選んでください") end
        return
    end
    PlayIndex(State.SelectedIndex)
end

local function SeekBy(seconds)
    if State.Sound and State.Sound.TimeLength > 0 then
        local newPos = State.Sound.TimePosition + seconds
        newPos = math.clamp(newPos, 0, State.Sound.TimeLength)
        State.Sound.TimePosition = newPos
    end
end

