local resizing = false
local resizeStartPos
local resizeStartW, resizeStartH

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        State._Resizing = true
        resizeStartPos = input.Position
        resizeStartW = State.CurrentW
        resizeStartH = State.CurrentH
        resizeHandle.TextColor3 = Theme.Accent
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not resizing then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - resizeStartPos
    local newW = math.clamp(resizeStartW + delta.X, MIN_W, MAX_W)
    local newH
    if State.IsMinimized then
        newH = Y_HEADER
    else
        newH = math.clamp(resizeStartH + delta.Y, MIN_H, MAX_H)
        State.NormalHeight = newH
    end

    State.CurrentW = newW
    State.CurrentH = newH

    main.Size = UDim2.fromOffset(newW, newH)

    if listFrame.Visible then
        listFrame.Size = UDim2.fromOffset(newW - 12, listFrame.Size.Y.Offset)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        if resizing then
            resizing = false
            State._Resizing = false
            resizeHandle.TextColor3 = Theme.TextDim
        end
    end
end)

