-- ============================================================
-- ★ 音に反応する波形バー（外枠の下端）
-- ============================================================
local WAVE_H     = 14
local WAVE_COUNT = 22

local waveFrame = Instance.new("Frame")
waveFrame.Name = "Waveform"
waveFrame.AnchorPoint = Vector2.new(0, 1)
waveFrame.Position = UDim2.new(0, 4, 1, -2)
waveFrame.Size = UDim2.new(1, -28, 0, WAVE_H)
waveFrame.BackgroundTransparency = 1
waveFrame.ClipsDescendants = true
waveFrame.ZIndex = 30
waveFrame.Parent = main

local waveBars = {}
for i = 1, WAVE_COUNT do
    local bar = Instance.new("Frame")
    bar.Name = "Bar" .. i
    bar.AnchorPoint = Vector2.new(0.5, 1)
    bar.Position = UDim2.new((i - 0.5) / WAVE_COUNT, 0, 1, 0)
    bar.Size = UDim2.new(0, 2, 0, 1)
    bar.BackgroundColor3 = Theme.Accent
    bar.BackgroundTransparency = 0.2
    bar.BorderSizePixel = 0
    bar.ZIndex = 31
    bar.Parent = waveFrame
    local bc = Instance.new("UICorner", bar)
    bc.CornerRadius = UDim.new(1, 0)
    waveBars[i] = bar
end

local smoothedLoudness = 0
task.spawn(function()
    while main and main.Parent do
        local target = 0
        if State.Sound and State.Sound.IsPlaying and not State.IsPaused and not State.IsMinimized then
            target = math.clamp((State.Sound.PlaybackLoudness or 0) / 550, 0, 1)
        end
        smoothedLoudness = smoothedLoudness + (target - smoothedLoudness) * 0.28

        local now = tick()
        for i = 1, WAVE_COUNT do
            local phase = (i / WAVE_COUNT) * math.pi * 2
            local wobble = (math.sin(now * 6 + phase) * 0.5 + 0.5) * 0.6 + 0.4
            local h = 1 + smoothedLoudness * (WAVE_H - 2) * wobble
            waveBars[i].Size = UDim2.new(0, 2, 0, h)
            waveBars[i].BackgroundTransparency = 0.5 - smoothedLoudness * 0.5
        end

        mainStroke.Thickness = 2 + smoothedLoudness * 1.6

        RunService.RenderStepped:Wait()
    end
end)

