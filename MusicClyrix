local function SetMinimized(minimized)
    if State.IsMinimized == minimized then return end
    State.IsMinimized = minimized

    if minimized and State.ListExpanded then
        SetListExpanded(false)
    end

    -- ボタンアイコンのアニメーション（＋ / －）
    if minimized then
        TweenService:Create(minimizeLineV, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Rotation = 90,
            BackgroundTransparency = 0,
        }):Play()
    else
        TweenService:Create(minimizeLineV, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Rotation = 0,
            BackgroundTransparency = 1,
        }):Play()
    end

    local fadeOutInfo = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeInInfo  = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local moveInfo    = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if minimized then
        -- 全部フェードアウト
        TweenService:Create(title, fadeOutInfo, { TextTransparency = 1 }):Play()
        TweenService:Create(nowPlayingLabel, fadeOutInfo, { TextTransparency = 1 }):Play()
        TweenService:Create(timeLabel, fadeOutInfo, { TextTransparency = 1 }):Play()
        TweenService:Create(resizeHandle, fadeOutInfo, { TextTransparency = 1 }):Play()

        task.delay(0.14, function()
            if not State.IsMinimized then return end

            -- ヘッダー内配置へスナップ
            nowPlayingLabel.AnchorPoint = Vector2.new(0, 0.5)
            nowPlayingLabel.Position = UDim2.new(0, 8, 0, Y_HEADER / 2)
            nowPlayingLabel.Size = UDim2.new(0, 80, 0, Y_NOWPLAY_H)
            nowPlayingLabel.TextXAlignment = Enum.TextXAlignment.Left

            timeLabel.AnchorPoint = Vector2.new(1, 0.5)
            timeLabel.Position = UDim2.new(1, -58, 0, Y_HEADER / 2)
            timeLabel.Size = UDim2.new(0, 60, 0, Y_TIME_H)
            timeLabel.TextXAlignment = Enum.TextXAlignment.Right

            waveFrame.Visible = false
            resizeHandle.Visible = false

            -- 上端固定で高さを縮小
            local curH = main.AbsoluteSize.Y
            local newH = Y_HEADER
            local newOffsetY = main.Position.Y.Offset + 0.5 * (newH - curH)
            TweenService:Create(main, moveInfo, {
                Size = UDim2.fromOffset(State.CurrentW, newH),
                Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset,
                                     main.Position.Y.Scale, newOffsetY),
            }):Play()

            -- フェードイン
            TweenService:Create(nowPlayingLabel, fadeInInfo, { TextTransparency = 0 }):Play()
            TweenService:Create(timeLabel, fadeInInfo, { TextTransparency = 0 }):Play()
        end)
    else
        -- 曲名と時間をフェードアウト
        TweenService:Create(nowPlayingLabel, fadeOutInfo, { TextTransparency = 1 }):Play()
        TweenService:Create(timeLabel, fadeOutInfo, { TextTransparency = 1 }):Play()

        task.delay(0.14, function()
            if State.IsMinimized then return end

            -- 通常配置へ戻す
            nowPlayingLabel.AnchorPoint = Vector2.new(0, 1)
            nowPlayingLabel.Position = UDim2.new(0, 6, 1, -(Y_BOTTOM_OFF + BOTTOM_ROW_H + 6 + Y_TIME_H + 4))
            nowPlayingLabel.Size = UDim2.new(1, -12, 0, Y_NOWPLAY_H)
