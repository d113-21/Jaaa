-- ============================================================
-- リスト開閉
-- ============================================================
local listOpenTween, listCloseTween
local currentAnimToken = 0

local function StopListTweens()
    if listOpenTween then pcall(function() listOpenTween:Cancel() end); listOpenTween = nil end
    if listCloseTween then pcall(function() listCloseTween:Cancel() end); listCloseTween = nil end
end

local function AnimateOpen()
    StopListTweens()
    currentAnimToken = currentAnimToken + 1
    local token = currentAnimToken

    listFrame.Visible = true
    State.Animating = true

    local w = State.CurrentW - 12
    listFrame.Size = UDim2.fromOffset(w, 0)
    listFrame.BackgroundTransparency = 1
    listStroke.Transparency = 1
    listFrame.Position = UDim2.fromOffset(GetListLeftX(), GetListTopY())

    for _, btn in ipairs(songButtons) do
        btn.BackgroundTransparency = 1
        btn.TextTransparency = 1
    end

    local targetSize = UDim2.fromOffset(w, LIST_EXPAND_H)

    listOpenTween = TweenService:Create(listFrame, TWEEN_INFO, {
        Size = targetSize,
        BackgroundTransparency = 0,
    })
    local strokeTween = TweenService:Create(listStroke, TWEEN_INFO, { Transparency = 0 })
    listOpenTween:Play()
    strokeTween:Play()

    task.delay(0.05, function()
        if token ~= currentAnimToken then return end
        for _, btn in ipairs(songButtons) do
            TweenService:Create(btn, TWEEN_INFO, {
                BackgroundTransparency = 0,
                TextTransparency = 0,
            }):Play()
        end
    end)

    listOpenTween.Completed:Connect(function()
        if token ~= currentAnimToken then return end
        State.Animating = false
    end)
end

local function AnimateClose()
    StopListTweens()
    currentAnimToken = currentAnimToken + 1
    local token = currentAnimToken

    State.Animating = true

    for _, btn in ipairs(songButtons) do
        TweenService:Create(btn, TWEEN_INFO, {
            BackgroundTransparency = 1,
            TextTransparency = 1,
        }):Play()
    end

    listCloseTween = TweenService:Create(listFrame, TWEEN_INFO, {
        Size = UDim2.fromOffset(listFrame.Size.X.Offset, 0),
        BackgroundTransparency = 1,
    })
    local strokeTween = TweenService:Create(listStroke, TWEEN_INFO, { Transparency = 1 })
    listCloseTween:Play()
    strokeTween:Play()

    listCloseTween.Completed:Connect(function()
        if token ~= currentAnimToken then return end
        listFrame.Visible = false
        State.Animating = false
    end)
end

function SetListExpanded(expanded)
    if State.ListExpanded == expanded and not State.Animating then return end
    State.ListExpanded = expanded
    listToggleBtn.Text = expanded and "▲" or "▼"

    if expanded then AnimateOpen() else AnimateClose() end
end

